# PostHog project token and host. Release builds get these from GitHub repo
# variables; locally, copy this file to .env.
VITE_POSTHOG_KEY=your_posthog_project_token
VITE_POSTHOG_HOST=https://eu.i.posthog.com

# Dev builds (npm run tauri dev) send nothing unless this is "true".
VITE_POSTHOG_ENABLE_IN_DEV=false
